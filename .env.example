# StreamSearch environment variables
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
ENV=development

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=video_embeddings
QDRANT_API_KEY=

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_INGEST=video.ingest
KAFKA_TOPIC_EMBED=video.embed

# CLIP / TensorRT
CLIP_MODEL_NAME=ViT-B/32
CLIP_DEVICE=cuda
TENSORRT_PRECISION=fp16
TENSORRT_MODEL_PATH=/models/encoder.engine

# UI
UI_HOST=0.0.0.0
UI_PORT=8501

# Logging
LOG_LEVEL=INFO
